#!/usr/bin/env bash
# Update WeChat: 1) refresh management scripts from the repo,
# 2) then update the AppImage. Instance data is preserved throughout.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=_scripts-update.sh
. "$SCRIPT_DIR/_scripts-update.sh"

# Scripts refresh failure is non-fatal: proceed with the local (possibly
# older) scripts so the AppImage can still be updated.
update_management_scripts wechat "$APP_DIR" || \
  echo "Warning: could not refresh management scripts; continuing with local copies." >&2

exec "$SCRIPT_DIR/install"
