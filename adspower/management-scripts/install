#!/usr/bin/env bash
set -euo pipefail
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_NAME="adspower"
API="https://api.github.com/repos/willowypanda/appimages-repo/releases?per_page=30"
mkdir -p "$APP_DIR"

read -r TAG ASSET_URL ASSET_NAME < <(curl --fail --location --silent --show-error "$API" | python3 -c '
import json,sys
for r in json.load(sys.stdin):
    assets=[a for a in r.get("assets",[]) if a.get("name","").startswith("adspower-") and a.get("name","").endswith(".AppImage")]
    if assets:
        a=assets[0]
        print(r["tag_name"], a["browser_download_url"], a["name"])
        break
else:
    raise SystemExit("no AdsPower AppImage asset found in recent releases")
')
TARGET="$APP_DIR/$ASSET_NAME"
MARKER="$APP_DIR/.release-tag"

if [ -f "$TARGET" ] && [ "$(cat "$MARKER" 2>/dev/null || true)" = "$TAG" ]; then
  chmod +x "$TARGET"
  echo "AdsPower $TAG is already installed: $TARGET"
  exit 0
fi

tmp="$(mktemp "$APP_DIR/.download.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
curl --fail --location --progress-bar "$ASSET_URL" -o "$tmp"
chmod +x "$tmp"
# Keep only the current AppImage; management scripts and instance data are preserved.
find "$APP_DIR" -maxdepth 1 -type f -name 'adspower-*.AppImage' -delete
mv "$tmp" "$TARGET"
printf '%s\n' "$TAG" > "$MARKER"
echo "Installed AdsPower $TAG: $TARGET"
