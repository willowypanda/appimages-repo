#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTANCE="${1:-default}"
shift || true
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
APPIMAGE="$(find "$APP_DIR" -maxdepth 1 -type f -name 'adspower-*.AppImage' -print -quit || true)"
[ -n "$APPIMAGE" ] || { echo "AdsPower is not installed. Use: custom-appimage-manager app adspower install" >&2; exit 1; }
exec "$SCRIPT_DIR/run-sandboxed.sh" --instance "$INSTANCE" --appimage "$APPIMAGE" -- "$@"