#!/usr/bin/env bash
set -euo pipefail
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
API="https://api.github.com/repos/willowypanda/appimages-repo/releases?per_page=30"
read -r REMOTE_TAG REMOTE_NAME < <(curl --fail --location --silent --show-error --max-time 30 "$API" | python3 -c '
import json,sys
for r in json.load(sys.stdin):
    a=next((x for x in r.get("assets",[]) if x.get("name","").startswith("adspower-") and x.get("name","").endswith(".AppImage")),None)
    if a:
        print(r["tag_name"], a["name"])
        break
else:
    raise SystemExit("no AdsPower AppImage asset found in recent releases")
')
LOCAL_TAG="$(cat "$APP_DIR/.release-tag" 2>/dev/null || true)"
LOCAL_FILE="$(find "$APP_DIR" -maxdepth 1 -type f -name 'adspower-*.AppImage' -print -quit || true)"
if [ -z "$LOCAL_FILE" ]; then
  echo "AdsPower is not installed. Use: custom-appimage-manager app adspower install"
  exit 1
fi
if [ "$LOCAL_TAG" = "$REMOTE_TAG" ]; then
  echo "AdsPower AppImage is up to date: $LOCAL_TAG ($REMOTE_NAME)"
else
  echo "AppImage update available: local=${LOCAL_TAG:-none}, remote=${REMOTE_TAG} (${REMOTE_NAME})"
fi

SCRIPT_JSON="$(curl --fail --location --silent --show-error --max-time 30 \
  "https://api.github.com/repos/willowypanda/appimages-repo/contents/adspower/management-scripts?ref=main")"
script_updates=0
while IFS=$'\t' read -r name url; do
  [ -n "$name" ] || continue
  local_hash="$(sha256sum "$APP_DIR/management-scripts/$name" 2>/dev/null | awk '{print $1}' || true)"
  remote_hash="$(curl --fail --location --silent --show-error --max-time 30 "$url" | sha256sum | awk '{print $1}')"
  if [ "$local_hash" != "$remote_hash" ]; then
    echo "Management script update available: $name"
    script_updates=$((script_updates + 1))
  fi
done < <(python3 -c 'import json,sys; [print(x["name"]+"\t"+x["download_url"]) for x in json.load(sys.stdin) if x.get("type")=="file"]' <<<"$SCRIPT_JSON")
if [ "$script_updates" -eq 0 ] && [ "$LOCAL_TAG" = "$REMOTE_TAG" ]; then
  echo "All AdsPower AppImage and management scripts are current."
else
  echo "$script_updates management script update(s) available. Run: custom-appimage-manager app adspower update"
fi
